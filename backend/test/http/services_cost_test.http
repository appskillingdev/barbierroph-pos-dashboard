
@baseUrl = http://localhost:3000/api

### Get cost breakdown of a service (description, cost_amount, minimum_qty from bph_inventory)
GET {{baseUrl}}/services/svc002/costs HTTP/1.1

### Get service costs that use an inventory product
GET {{baseUrl}}/services/costs/product/prod001 HTTP/1.1

### Add service cost (cost_id must be a bph_inventory product_id; item_number defaults to the next number)
POST {{baseUrl}}/services/svc003/costs HTTP/1.1
Content-Type: application/json

{
  "cost_id": "prod003",
  "multiplier": 2
}

### Update service cost
PUT {{baseUrl}}/services/svc003/costs/001/prod003 HTTP/1.1
Content-Type: application/json

{
  "cost_category": "Product",
  "multiplier": 3
}

### Delete service cost
DELETE {{baseUrl}}/services/svc003/costs/001/prod003 HTTP/1.1
