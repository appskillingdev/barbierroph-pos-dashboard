@baseUrl = http://localhost:3000/api
### Get all payment methods
GET {{baseUrl}}/payment-methods HTTP/1.1

### Filter and sort payment methods
GET {{baseUrl}}/payment-methods?payment_method_name.contains=card&sortBy=payment_method_name&sortOrder=asc&limit=10 HTTP/1.1

### Get payment method by name
GET {{baseUrl}}/payment-methods/cash HTTP/1.1

### Get active payment methods
GET {{baseUrl}}/payment-methods/active HTTP/1.1

### Create new payment method
POST {{baseUrl}}/payment-methods HTTP/1.1
Content-Type: application/json

{
  "paymentMethodName": "test-payment",
  "paymentMethodDescription": "Test Payment Method",
  "paymentMethodValidity": "ACTIVE"
}

### Update payment method
PUT {{baseUrl}}/payment-methods/test-payment HTTP/1.1
Content-Type: application/json

{
  "paymentMethodDescription": "Updated Test Payment Method",
  "paymentMethodValidity": "INACTIVE"
}

### Delete payment method
DELETE {{baseUrl}}/payment-methods/test-payment HTTP/1.1
