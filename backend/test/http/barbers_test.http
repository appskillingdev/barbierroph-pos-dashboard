@baseUrl = http://localhost:3000/api

### Get all barbers
GET {{baseUrl}}/barbers HTTP/1.1

### Filter and sort barbers
GET {{baseUrl}}/barbers?branch_id=branch001&sortBy=full_name&sortOrder=asc&limit=10 HTTP/1.1

### Get barber by ID
GET {{baseUrl}}/barbers/barber001 HTTP/1.1

### Get barbers by branch
GET {{baseUrl}}/barbers/branch/branch001 HTTP/1.1

### Create new barber
POST {{baseUrl}}/barbers HTTP/1.1
Content-Type: application/json

{
  "barberId": "TEST-BARBER",
  "barberFirstName": "Test",
  "barberLastName": "Barber",
  "barberContactNumber": "09123456789",
  "barberEmail": "testbarber@barbierro.com",
  "branchId": "branch001",
  "barberPayScheme": "commission",
  "barberCommissionRate": 0.60,
  "barberValidity": "ACTIVE"
}

### Update barber
PUT {{baseUrl}}/barbers/TEST-BARBER HTTP/1.1
Content-Type: application/json

{
  "barberContactNumber": "09987654321",
  "barberCommissionRate": 0.65
}

### Delete barber
DELETE {{baseUrl}}/barbers/TEST-BARBER HTTP/1.1
