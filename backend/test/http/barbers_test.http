### Get all barbers
GET http://localhost:3000/barbers HTTP/1.1

### Get barber by ID
GET http://localhost:3000/barbers/barber001 HTTP/1.1

### Get barbers by branch
GET http://localhost:3000/barbers/branch/branch001 HTTP/1.1

### Create new barber
POST http://localhost:3000/barbers HTTP/1.1
Content-Type: application/json

{
  "barberId": "TEST-BARBER",
  "barberFirstName": "Test",
  "barberLastName": "Barber",
  "barberContactNumber": "09123456789",
  "barberEmail": "testbarber@barbierro.com",
  "branchId": "branch001",
  "barberPayScheme": "commission",
  "barberCommissionRate": 0.60,
  "barberValidity": "ACTIVE"
}

### Update barber
PUT http://localhost:3000/barbers/TEST-BARBER HTTP/1.1
Content-Type: application/json

{
  "barberContactNumber": "09987654321",
  "barberCommissionRate": 0.65
}

### Delete barber
DELETE http://localhost:3000/barbers/TEST-BARBER HTTP/1.1
