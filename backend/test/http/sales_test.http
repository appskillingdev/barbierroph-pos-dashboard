
@baseUrl = http://localhost:3000/api

### Get all sales
GET {{baseUrl}}/sales HTTP/1.1

### Filter and sort sales
GET {{baseUrl}}/sales?payment_method=cash&sortBy=transaction_date&sortOrder=desc&limit=10 HTTP/1.1

### Get latest 10 sales
GET {{baseUrl}}/sales/latest?limit=10 HTTP/1.1

### Get sales by transaction ID
GET {{baseUrl}}/sales/transaction/TXN-001 HTTP/1.1

### Get sales by date range
GET {{baseUrl}}/sales/date-range?startDate=2024-01-01&endDate=2024-12-31 HTTP/1.1

### Get sales by customer
GET {{baseUrl}}/sales/customer/cust001 HTTP/1.1

### Get sales by branch
GET {{baseUrl}}/sales/branch/branch001 HTTP/1.1

### Get sales by barber
GET {{baseUrl}}/sales/barber/barber001 HTTP/1.1

### Get sales by payment method
GET {{baseUrl}}/sales/payment-method/cash HTTP/1.1

### Create new sale
POST {{baseUrl}}/sales HTTP/1.1
Content-Type: application/json

{
  "transactionId": "TXN-TEST-001",
  "transactionDate": "2024-01-15",
  "customerId": "cust001",
  "branchId": "branch001",
  "barberId": "barber001",
  "serviceCode": "REG-CUT",
  "totalAmount": 150.00,
  "paymentMethod": "cash",
  "referenceNo": "REF-001",
  "count1": 0,
  "count5": 0,
  "count10": 0,
  "count20": 1,
  "count50": 0,
  "count100": 1,
  "count200": 0,
  "count500": 0,
  "count1000": 0,
  "createdBy": "owner001"
}

### Update sale
PUT {{baseUrl}}/sales/TXN-TEST-001 HTTP/1.1
Content-Type: application/json

{
  "totalAmount": 175.00,
  "paymentMethod": "gcash"
}

### Delete sale
DELETE {{baseUrl}}/sales/TXN-TEST-001 HTTP/1.1