@baseUrl = http://localhost:3000/api
### Get all queue entries
GET {{baseUrl}}/queue HTTP/1.1

### Filter and sort queue entries
GET {{baseUrl}}/queue?status=waiting&sortBy=appointment_date&sortOrder=asc&limit=10 HTTP/1.1

### Get queue entry by ID
GET {{baseUrl}}/queue/1 HTTP/1.1

### Get queue by branch
GET {{baseUrl}}/queue/branch/branch001 HTTP/1.1

### Get queue by status
GET {{baseUrl}}/queue/status/waiting HTTP/1.1

### Get queue by customer
GET {{baseUrl}}/queue/customer?name=Juan HTTP/1.1

### Create new queue entry
POST {{baseUrl}}/queue HTTP/1.1
Content-Type: application/json

{
  "queueCustomerName": "Test Customer",
  "queueBranchId": "branch001",
  "queueBarberId": "barber001",
  "queueServiceCode": "REG-CUT",
  "queueStatus": "waiting",
  "queueTimestamp": "2024-01-15T10:00:00"
}

### Update queue entry
PUT {{baseUrl}}/queue/1 HTTP/1.1
Content-Type: application/json

{
  "queueStatus": "in-service",
  "queueStartTime": "2024-01-15T10:05:00"
}

### Update queue status
PUT {{baseUrl}}/queue/1/status HTTP/1.1
Content-Type: application/json

{
  "status": "completed"
}

### Delete queue entry
DELETE {{baseUrl}}/queue/1 HTTP/1.1
