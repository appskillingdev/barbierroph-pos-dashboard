@baseUrl = http://localhost:3000/api

### Get all services
GET {{baseUrl}}/services HTTP/1.1

### Filter and sort services
GET {{baseUrl}}/services?service_name.contains=Test&sortBy=service_amount&sortOrder=asc&limit=10 HTTP/1.1

### Get service by code
GET {{baseUrl}}/services/REG-CUT HTTP/1.1

### Get services by category
GET {{baseUrl}}/services/category/haircut HTTP/1.1

### Get promo services
GET {{baseUrl}}/services/promos HTTP/1.1

### Create new service
POST {{baseUrl}}/services HTTP/1.1
Content-Type: application/json

{
  "serviceCode": "TEST-CUT",
  "serviceName": "Test Haircut",
  "serviceCategory": "haircut",
  "serviceDescription": "Test haircut service",
  "servicePrice": 200.00,
  "servicePromo": 0,
  "servicePromoPrice": 0,
  "serviceValidity": "ACTIVE"
}

### Update service
PUT {{baseUrl}}/services/TEST-CUT HTTP/1.1
Content-Type: application/json

{
  "servicePrice": 250.00,
  "servicePromo": 1,
  "servicePromoPrice": 200.00
}

### Delete service
DELETE {{baseUrl}}/services/TEST-CUT HTTP/1.1
