@baseUrl = http://localhost:3000/api
### Get all slots
GET {{baseUrl}}/slots HTTP/1.1

### Filter and sort slots
GET {{baseUrl}}/slots?status=available&sortBy=slot_id&sortOrder=asc&limit=10 HTTP/1.1

### Get slot by ID
GET {{baseUrl}}/slots/1 HTTP/1.1

### Get slots by branch
GET {{baseUrl}}/slots/branch/branch001 HTTP/1.1

### Get slots by barber
GET {{baseUrl}}/slots/barber/barber001 HTTP/1.1

### Get available slots by branch
GET {{baseUrl}}/slots/available/branch001 HTTP/1.1

### Get slots by date range
GET {{baseUrl}}/slots/date-range?startDate=2024-01-01&endDate=2024-01-31 HTTP/1.1

### Create new slot
POST {{baseUrl}}/slots HTTP/1.1
Content-Type: application/json

{
  "slotBranchId": "branch001",
  "slotBarberId": "barber001",
  "slotDate": "2024-01-20",
  "slotStartTime": "10:00:00",
  "slotEndTime": "11:00:00",
  "slotStatus": "available",
  "slotMaxCapacity": 1,
  "slotCurrentBookings": 0
}

### Update slot
PUT {{baseUrl}}/slots/1 HTTP/1.1
Content-Type: application/json

{
  "slotStatus": "booked",
  "slotCurrentBookings": 1
}

### Delete slot
DELETE {{baseUrl}}/slots/1 HTTP/1.1
