@baseUrl = http://localhost:3000/api
### Get all customers
GET {{baseUrl}}/customers HTTP/1.1

### Filter and sort customers
GET {{baseUrl}}/customers?customer_name.contains=Test&sortBy=visit_count&sortOrder=desc&limit=10 HTTP/1.1

### Filter customers by company
GET {{baseUrl}}/customers?company.contains=AppSkilling HTTP/1.1

### Get customer by ID
GET {{baseUrl}}/customers/cust001 HTTP/1.1

### Get top customers
GET {{baseUrl}}/customers/top?limit=10 HTTP/1.1

### Create new customer
POST {{baseUrl}}/customers HTTP/1.1
Content-Type: application/json

{
  "customer_id": "TEST-CUST",
  "customer_name": "Test Customer",
  "customer_address": "123 Test St",
  "contact_number": "09123456789",
  "email_address": "testcustomer@email.com",
  "visit_count": 0,
  "company": "AppSkilling"
}

### Update customer
PUT {{baseUrl}}/customers/TEST-CUST HTTP/1.1
Content-Type: application/json

{
  "customer_name": "Test Customer",
  "customer_address": "123 Test St",
  "contact_number": "09987654321",
  "email_address": "testcustomer@email.com",
  "visit_count": 100,
  "company": "Barbierro PH"
}

### Increment customer visit count
PATCH {{baseUrl}}/customers/TEST-CUST/visit HTTP/1.1

### Delete customer
DELETE {{baseUrl}}/customers/TEST-CUST HTTP/1.1
