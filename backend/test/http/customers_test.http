@baseUrl = http://localhost:3000/api
### Get all customers
GET {{baseUrl}}/customers HTTP/1.1

### Filter and sort customers
GET {{baseUrl}}/customers?customer_name.contains=Test&sortBy=visit_count&sortOrder=desc&limit=10 HTTP/1.1

### Get customer by ID
GET {{baseUrl}}/customers/cust001 HTTP/1.1

### Get top customers
GET {{baseUrl}}/customers/top?limit=10 HTTP/1.1

### Create new customer
POST {{baseUrl}}/customers HTTP/1.1
Content-Type: application/json

{
  "customerId": "TEST-CUST",
  "customerFirstName": "Test",
  "customerLastName": "Customer",
  "customerGender": "M",
  "customerContactNumber": "09123456789",
  "customerEmail": "testcustomer@email.com",
  "customerAddress": "123 Test St",
  "customerVisitCount": 0,
  "customerLoyaltyPoints": 0,
  "customerStatus": "ACTIVE"
}

### Update customer
PUT {{baseUrl}}/customers/TEST-CUST HTTP/1.1
Content-Type: application/json

{
  "customerContactNumber": "09987654321",
  "customerLoyaltyPoints": 100
}

### Increment customer visit count
PUT {{baseUrl}}/customers/TEST-CUST/visit HTTP/1.1

### Delete customer
DELETE {{baseUrl}}/customers/TEST-CUST HTTP/1.1
