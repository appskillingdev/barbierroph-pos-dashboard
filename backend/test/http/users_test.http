@baseUrl = http://localhost:3000/api
### Get all users
GET {{baseUrl}}/users HTTP/1.1

### Filter and sort users
GET {{baseUrl}}/users?user_type=P01&sortBy=created_at&sortOrder=desc&limit=10 HTTP/1.1

### Get user by ID
GET {{baseUrl}}/users/owner001 HTTP/1.1

### Create new user
POST {{baseUrl}}/users HTTP/1.1
Content-Type: application/json

{
  "ID": "TEST-USER",
  "firstName": "Test",
  "lastName": "User",
  "role": "staff",
  "gender": "M",
  "email": "testuser@barbierro.com",
  "contactNumber": "09123456789",
  "password": "password123",
  "address": "123 Test St",
  "city": "Manila",
  "province": "NCR",
  "region": "NCR",
  "birthdate": "1990-01-01",
  "status": "ACTIVE"
}

### Update user
PUT {{baseUrl}}/users/TEST-USER HTTP/1.1
Content-Type: application/json

{
  "contactNumber": "09987654321",
  "email": "updated@barbierro.com"
}

### Delete user
DELETE {{baseUrl}}/users/TEST-USER HTTP/1.1
