@baseUrl = http://localhost:3000/api

### Get all checkouts
GET {{baseUrl}}/checkout HTTP/1.1

### Filter and sort checkouts
GET {{baseUrl}}/checkout?assigned_branch=branch001&sortBy=purchased_at&sortOrder=desc&limit=10 HTTP/1.1

### Get checkout by ID
GET {{baseUrl}}/checkout/1 HTTP/1.1

### Get checkouts by branch
GET {{baseUrl}}/checkout/branch/branch001 HTTP/1.1

### Get checkouts by date range
GET {{baseUrl}}/checkout/date-range?startDate=2024-01-01&endDate=2024-12-31 HTTP/1.1

### Get checkouts by customer name
GET {{baseUrl}}/checkout/customer?name=Juan HTTP/1.1

### Create new checkout
POST {{baseUrl}}/checkout HTTP/1.1
Content-Type: application/json

{
  "checkoutCustomerName": "Test Customer",
  "checkoutBranchId": "branch001",
  "checkoutBarberId": "barber001",
  "checkoutServiceCode": "REG-CUT",
  "checkoutTotalAmount": 150.00,
  "checkoutPaymentMethod": "cash",
  "checkoutReferenceNo": "REF-TEST-001",
  "checkoutTransactionDate": "2024-01-15"
}

### Update checkout
PUT {{baseUrl}}/checkout/1 HTTP/1.1
Content-Type: application/json

{
  "checkoutTotalAmount": 175.00,
  "checkoutPaymentMethod": "gcash"
}

### Delete checkout
DELETE {{baseUrl}}/checkout/1 HTTP/1.1
