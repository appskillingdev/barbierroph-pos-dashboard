@baseUrl = http://localhost:3000/api

### Get all branches
GET {{baseUrl}}/branches HTTP/1.1

### Filter and sort branches
GET {{baseUrl}}/branches?branch_location=Manila&sortBy=branch_address&sortOrder=asc&limit=10 HTTP/1.1

### Get branch by ID
GET {{baseUrl}}/branches/branch001 HTTP/1.1

### Get branches by owner
GET {{baseUrl}}/branches/owner/owner001 HTTP/1.1

### Get branches by location
GET {{baseUrl}}/branches/location?city=Manila&province=NCR HTTP/1.1

### Create new branch
POST {{baseUrl}}/branches HTTP/1.1
Content-Type: application/json

{
  "branchId": "TEST-BRANCH",
  "branchName": "Test Branch",
  "branchAddress": "123 Test St",
  "branchCity": "Manila",
  "branchProvince": "NCR",
  "branchRegion": "NCR",
  "branchContactNumber": "09123456789",
  "branchEmail": "test@barbierro.com",
  "branchOwner": "owner001",
  "branchDescription": "Test branch",
  "branchValidity": "ACTIVE"
}

### Update branch
PUT {{baseUrl}}/branches/TEST-BRANCH HTTP/1.1
Content-Type: application/json

{
  "branchContactNumber": "09987654321",
  "branchDescription": "Updated test branch"
}

### Delete branch
DELETE {{baseUrl}}/branches/TEST-BRANCH HTTP/1.1
