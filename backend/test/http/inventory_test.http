@baseUrl = http://localhost:3000/api

### Get all inventory items
GET {{baseUrl}}/inventory HTTP/1.1

### Filter and sort inventory
GET {{baseUrl}}/inventory?category=CAT-001&sortBy=product_name&sortOrder=asc&limit=10 HTTP/1.1

### Get inventory item by code
GET {{baseUrl}}/inventory/PROD-001 HTTP/1.1

### Get inventory by category
GET {{baseUrl}}/inventory/category/CAT-001 HTTP/1.1

### Get low stock items
GET {{baseUrl}} /inventory/low-stock?threshold=10 HTTP/1.1

### Create new inventory item
POST {{baseUrl}}/inventory HTTP/1.1
Content-Type: application/json

{
  "productCode": "TEST-PROD",
  "productName": "Test Product",
  "productBrand": "Test Brand",
  "productDescription": "Test product description",
  "productCategory": "CAT-001",
  "productQuantity": 50,
  "productUnit": "pcs",
  "productCost": 100.00,
  "productValidity": "ACTIVE"
}

### Update inventory item
PUT {{baseUrl}}/inventory/TEST-PROD HTTP/1.1
Content-Type: application/json

{
  "productQuantity": 75,
  "productCost": 120.00
}

### Update inventory stock
PUT {{baseUrl}}/inventory/TEST-PROD/stock HTTP/1.1
Content-Type: application/json

{
  "quantityChange": -5,
  "actionType": "usage",
  "notes": "Used for customer service"
}

### Delete inventory item
DELETE {{baseUrl}}/inventory/TEST-PROD HTTP/1.1
